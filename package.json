{
  "name": "mermaid-cli-grpc-wrapper-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:nocheck": "vite build",
    "build:proto": "proto-loader-gen-types --enums=String --defaults --grpcLib=@grpc/grpc-js --outDir=src/proto/ proto/*.proto",
    "preview": "dotenv -e .env.local -e .env -- node dist/main.js | pino-pretty"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.3"
  }
}
